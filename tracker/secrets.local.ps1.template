# ---------------------------------------------------------------------------
# COPY this file to  secrets.local.ps1  (same folder) and fill in your values.
#
#   secrets.local.ps1 is read by run_daily.ps1 and by manual runs.
#   Keep it on your machine only — do NOT publish or share it, and it should
#   never be uploaded as part of the tracker.
# ---------------------------------------------------------------------------

$env:TRELLO_KEY   = "paste_your_trello_key_here"
$env:TRELLO_TOKEN = "paste_your_trello_token_here"

# Optional: a GitHub personal access token so the collector can pull PRIVATE
# repos (e.g. Nerds with Ag) live instead of using the seeded fallback.
# $env:GITHUB_TOKEN = "ghp_xxxxxxxxxxxxxxxx"

# Firestore sync (Project Peek web app). Set both to have the daily job push data
# to the app after each run. Leave unset to skip the push.
#   FIREBASE_UID: your account UID (shown on the app's "No data yet" screen)
#   GOOGLE_APPLICATION_CREDENTIALS: full path to your service-account key JSON (keep private)
$env:FIREBASE_UID = "paste_your_account_uid_here"
$env:GOOGLE_APPLICATION_CREDENTIALS = "$PSScriptRoot\serviceAccountKey.json"
