rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Instructors sign in with @neumont.edu, students with @student.neumont.edu.
    // Only staff can own courses; only student accounts get the student paths.
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isStaff() {
      return isVerified() && request.auth.token.email.lower().matches('[^@]+@neumont[.]edu');
    }

    function isStudent() {
      return isVerified() && request.auth.token.email.lower().matches('[^@]+@student[.]neumont[.]edu');
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function isOwner(ownerUid) {
      return isStaff() && request.auth.uid == ownerUid;
    }

    function coursePath(ownerUid, courseId) {
      return /databases/$(database)/documents/users/$(ownerUid)/courses/$(courseId);
    }

    function teamPath(ownerUid, courseId, teamId) {
      return /databases/$(database)/documents/users/$(ownerUid)/courses/$(courseId)/teams/$(teamId);
    }

    function isCourseStudent(ownerUid, courseId) {
      return isStudent()
        && email() in get(coursePath(ownerUid, courseId)).data.studentEmails;
    }

    // Students can change a sprint through one grace day after its end date. The end
    // date is a Mountain-time calendar day, so the cut-off is midnight starting
    // end+2 days, taken as 07:00 UTC (an hour lenient during daylight time).
    function sprintOpen(ownerUid, courseId, sprintId) {
      let end = get(/databases/$(database)/documents/users/$(ownerUid)/courses/$(courseId)/sprints/$(sprintId)).data.get('end', '');
      return end == ''
        || request.time < timestamp.date(int(end.split('-')[0]), int(end.split('-')[1]), int(end.split('-')[2]))
             + duration.value(2, 'd') + duration.value(7, 'h');
    }

    // A student's sprint is locked for them once they've submitted their wrap-up.
    function submitted(ownerUid, courseId, sprintId, teamId) {
      return exists(/databases/$(database)/documents/users/$(ownerUid)/courses/$(courseId)/sprints/$(sprintId)/entries/$(teamId)/retro/$(email()));
    }

    function isTeamStudent(ownerUid, courseId, teamId) {
      return isStudent()
        && email() in get(teamPath(ownerUid, courseId, teamId)).data.studentEmails;
    }

    // Collection-group lookup a student uses to find their assigned teams. The
    // nested teams match below doesn't cover collection-group queries.
    match /{path=**}/teams/{teamId} {
      allow read: if isStudent() && email() in resource.data.studentEmails;
    }

    // Collection-group lookup a student uses to find the courses they're enrolled in.
    match /{path=**}/enrollments/{enrollmentId} {
      allow read: if isStudent() && resource.data.email == email();
    }

    match /users/{ownerUid} {
      allow read, write: if isOwner(ownerUid);

      match /courses/{courseId} {
        // Owner-only: the course doc holds the full enrollment list (studentEmails).
        // Students still pass isCourseStudent checks below, since rules-side get()
        // isn't limited by this read rule.
        allow read, write: if isOwner(ownerUid);

        match /teams/{teamId} {
          allow read: if isOwner(ownerUid)
            || (isStudent() && email() in resource.data.studentEmails);
          allow delete: if isOwner(ownerUid);
          // In a solo course an enrolled student creates their own one-person project.
          // The id is fixed per student, so they can only ever create one.
          allow create: if isOwner(ownerUid)
            || (isCourseStudent(ownerUid, courseId)
              && get(coursePath(ownerUid, courseId)).data.get('type', 'team') == 'solo'
              && teamId == 'solo-' + email().split('@')[0]
              && request.resource.data.studentEmails == [email()]
              && request.resource.data.ownerUid == ownerUid
              && request.resource.data.courseId == courseId
              && request.resource.data.type == 'solo'
              && request.resource.data.status == 'unrated'
              && request.resource.data.setupComplete == false
              && request.resource.data.keys().hasOnly(['team', 'members', 'project',
                   'studentEmails', 'type', 'ownerUid', 'courseId', 'courseCode',
                   'courseName', 'courseType', 'github', 'trello', 'status',
                   'setupComplete', 'createdAt', 'updatedAt']));
          // Students set up their own project: title, description, and the repo/board
          // links. Membership (studentEmails) stays instructor-written, so a student
          // can never add themselves to another project. On a solo project the student
          // can also fix their display name (team and members, kept identical).
          allow update: if isOwner(ownerUid)
            || (isTeamStudent(ownerUid, courseId, teamId)
              && (request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['studentProject', 'project', 'github', 'trello',
                              'setupComplete', 'updatedAt'])
                || (resource.data.get('type', 'team') == 'solo'
                  && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['team', 'members', 'updatedAt'])
                  && request.resource.data.team is string
                  && request.resource.data.team.size() > 0
                  && request.resource.data.team.size() <= 80
                  && request.resource.data.members == request.resource.data.team)));
        }

        match /enrollments/{enrollmentId} {
          allow read, write: if isOwner(ownerUid);
        }

        match /notes/{noteId} {
          allow read, write: if isOwner(ownerUid);
        }

        match /sprints/{sprintId} {
          allow read: if isOwner(ownerUid) || isCourseStudent(ownerUid, courseId);
          allow write: if isOwner(ownerUid);

          match /entries/{teamId} {
            allow read: if isOwner(ownerUid) || isTeamStudent(ownerUid, courseId, teamId);
            allow write: if isOwner(ownerUid);

            match /goals/{goalId} {
              allow read: if isOwner(ownerUid) || isTeamStudent(ownerUid, courseId, teamId);
              allow write: if isOwner(ownerUid);
              allow create: if isTeamStudent(ownerUid, courseId, teamId)
                && !submitted(ownerUid, courseId, sprintId, teamId)
                && sprintOpen(ownerUid, courseId, sprintId)
                && request.resource.data.studentEmail == email()
                && request.resource.data.completed == false;
              // Students edit their goal text and mark their own result until they submit.
              allow update: if isTeamStudent(ownerUid, courseId, teamId)
                && !submitted(ownerUid, courseId, sprintId, teamId)
                && sprintOpen(ownerUid, courseId, sprintId)
                && resource.data.studentEmail == email()
                && request.resource.data.studentEmail == resource.data.studentEmail
                && request.resource.data.completed == resource.data.completed
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['text', 'result', 'updatedAt'])
                && request.resource.data.get('result', '') in ['', 'done', 'partial', 'notdone'];
              allow delete: if isTeamStudent(ownerUid, courseId, teamId)
                && !submitted(ownerUid, courseId, sprintId, teamId)
                && sprintOpen(ownerUid, courseId, sprintId)
                && resource.data.studentEmail == email()
                && resource.data.completed == false;
            }

            match /time/{timeId} {
              allow read: if isOwner(ownerUid) || isTeamStudent(ownerUid, courseId, teamId);
              allow write: if isOwner(ownerUid);
              allow create: if isTeamStudent(ownerUid, courseId, teamId)
                && !submitted(ownerUid, courseId, sprintId, teamId)
                && sprintOpen(ownerUid, courseId, sprintId)
                && request.resource.data.studentEmail == email();
              allow update: if isTeamStudent(ownerUid, courseId, teamId)
                && !submitted(ownerUid, courseId, sprintId, teamId)
                && sprintOpen(ownerUid, courseId, sprintId)
                && resource.data.studentEmail == email()
                && request.resource.data.studentEmail == resource.data.studentEmail
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['date', 'hours', 'note', 'updatedAt']);
              allow delete: if isTeamStudent(ownerUid, courseId, teamId)
                && !submitted(ownerUid, courseId, sprintId, teamId)
                && sprintOpen(ownerUid, courseId, sprintId)
                && resource.data.studentEmail == email();
            }

            // When a student last opened this sprint (doc id = their email), so the app can
            // flag a rating or review newer than that as "New feedback".
            match /seen/{seenId} {
              allow read: if isOwner(ownerUid) || isTeamStudent(ownerUid, courseId, teamId);
              allow delete: if isOwner(ownerUid);
              allow create, update: if isTeamStudent(ownerUid, courseId, teamId)
                && seenId == email()
                && request.resource.data.keys().hasOnly(['at']);
            }

            // End-of-sprint wrap-up, one per student (doc id = their email). Creating it
            // submits the sprint; only the instructor can change or delete (reopen) it. Mood 1
            // (Rough) is retired; older wrap-ups may still hold it.
            match /retro/{retroId} {
              allow read: if isOwner(ownerUid) || isTeamStudent(ownerUid, courseId, teamId);
              allow write: if isOwner(ownerUid);
              allow create: if isTeamStudent(ownerUid, courseId, teamId)
                && sprintOpen(ownerUid, courseId, sprintId)
                && retroId == email()
                && request.resource.data.studentEmail == email()
                && request.resource.data.mood is int
                && request.resource.data.mood >= 2 && request.resource.data.mood <= 5
                && request.resource.data.wentWell is string && request.resource.data.wentWell.size() <= 4000
                && request.resource.data.improve is string && request.resource.data.improve.size() <= 4000
                && request.resource.data.keys().hasOnly(['studentEmail', 'mood', 'wentWell',
                     'improve', 'submittedAt']);
            }
          }
        }
      }
    }
  }
}
